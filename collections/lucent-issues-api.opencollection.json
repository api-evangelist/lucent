{
  "opencollection": "1.0.0",
  "info": {
    "name": "Lucent Insights Issues API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Issues",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List issues",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.lucenthq.com/api/v1/issues",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum issues to return."
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Opaque pagination cursor returned as `nextCursor` from the previous page."
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter issues by status."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists issues visible to the bearer token's organization, ordered by `createdAt` descending and then `id` descending."
        },
        {
          "info": {
            "name": "Get an issue",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.lucenthq.com/api/v1/issues/:issueId",
            "params": [
              {
                "name": "issueId",
                "value": "",
                "type": "path",
                "description": "Issue UUID."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Fetches a single issue by UUID for the bearer token's organization."
        },
        {
          "info": {
            "name": "Update issue status",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://app.lucenthq.com/api/v1/issues/:issueId",
            "params": [
              {
                "name": "issueId",
                "value": "",
                "type": "path",
                "description": "Issue UUID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates an issue's status. The operation is idempotent: setting the current status again returns `200` with the unchanged issue."
        }
      ]
    }
  ],
  "bundled": true
}