{
  "opencollection": "1.0.0",
  "info": {
    "name": "Lucent Insights API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Insights",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List insights",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.lucenthq.com/api/v1/insights",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum insights to return."
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Opaque pagination cursor returned as `nextCursor` from the previous page."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists recent AI-generated insights for the bearer token's organization."
        }
      ]
    }
  ],
  "bundled": true
}